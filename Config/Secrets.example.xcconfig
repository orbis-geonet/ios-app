//
// Secrets.example.xcconfig
// Orbis-iOS
//
// Template for the local secrets file. To set up:
//   1. Copy this file to Config/Secrets.xcconfig
//   2. Fill in the real values (ask a team member or check the credentials vault)
//
// Config/Secrets.xcconfig is gitignored and must NEVER be committed.
// This mirrors local.properties / keystore.properties on the Android project.
//

// Backend master key sent as the X-Master-Key HTTP header (Android BuildConfig.X_MASTER_KEY)
X_MASTER_KEY = your_master_key_here

// Google Maps / Places SDK keys (per environment)
GOOGLE_API_KEY_STAGING = your_staging_google_api_key_here
GOOGLE_API_KEY_PRODUCTION = your_production_google_api_key_here

// Branch.io SDK keys
BRANCH_KEY_LIVE = key_live_xxx
BRANCH_KEY_TEST = key_test_xxx
